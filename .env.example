# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# Database connection (SQLite used by default for local development)
DATABASE_URL="file:./dev.db"

# OpenAI API Key used for the `@ai-sdk/openai` Vercel AI integration
# Required for generating the mind map nodes and edges
OPENAI_API_KEY="sk-proj-..."

# NextAuth Configuration (Optional, if you decide to implement Google/GitHub OAuth later)
# NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET="generate-a-random-secret"
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
