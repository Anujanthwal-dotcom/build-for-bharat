# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# Database connection (SQLite used by default for local development)
DATABASE_URL="file:./dev.db"

# Google Gemini API Key used by LangChain.js (@langchain/google) for mind map generation
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY="AIza..."

# NextAuth v4 — Google OAuth
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET="Ex+AGqLX5lAiTSBZ6ryDYC46uQHidBD4euBu1YEJbrk="

# Google Cloud Console -> APIs & Services -> Credentials -> Create Credentials -> OAuth client ID
# Application type: Web application
# Authorized redirect URIs:
#   Local:  http://localhost:3000/api/auth/callback/google
#   Prod:   https://<your-domain>/api/auth/callback/google
#
# To create a client: https://console.cloud.google.com/apis/credentials
#   - If prompted, create/select a project, configure the OAuth consent screen,
#     then "Create Credentials" -> "OAuth client ID" -> application type "Web".
#   - Copy the Client ID into AUTH_GOOGLE_ID and the Client Secret into
#     AUTH_GOOGLE_SECRET below.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# NextAuth base URL. Set to the deployed URL in production (NEXTAUTH_URL is
# auto-detected in Vercel, but you can set it explicitly).
NEXTAUTH_URL="http://localhost:3000"