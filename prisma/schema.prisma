datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String            @id @default(cuid())
  name            String?
  email           String?           @unique
  emailVerified   DateTime?
  image           String?
  accounts        Account[]
  sessions        Session[]
  projects        Project[]
  preferences     UserPreferences?
  customTemplates CustomTemplate[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources     Source[]
  nodes       MindNode[]
  edges       MindEdge[]

  @@index([userId])
}

model Source {
  id        String  @id @default(cuid())
  type      String
  content   String
  label     String
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model MindNode {
  id        String   @id @default(cuid())
  nodeId    String
  label     String
  summary   String
  category  String
  tags      Json?
  x         Float?
  y         Float?
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model UserPreferences {
  id           String @id @default(cuid())
  userId       String @unique
  theme        String @default("dark")
  defaultDepth String @default("standard")
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MindEdge {
  id        String   @id @default(cuid())
  edgeId    String
  source    String
  target    String
  label     String?
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model CustomTemplate {
  id                 String   @id @default(cuid())
  name               String
  emoji              String   @default("📝")
  description        String
  tags               String   @default("[]")
  systemInstructions String
  defaultDepth       String   @default("standard")
  suggestedInput     String   @default("any")
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
}